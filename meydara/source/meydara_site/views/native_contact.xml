<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data noupdate="1">
    <template id="native_contact" inherit_id="website.contactus" name="Midara native contact page" website_id="website.default_website">
      <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty md-v2 mw-page">
          <section class="s_meydara_story md-section mw-inner-hero pt96 pb112" data-snippet="s_meydara_story" data-name="Contact Midara">
            <div class="container md-split">
              <div>
                <p class="md-eyebrow">Contact Midara</p>
                <h1>Let's talk about your team.</h1>
                <p class="md-lead">Have a question about Midara, your workflow or the Odoo connection? Send us the details so we can help you find the right next step.</p>
                <div class="md-related">
                  <a href="/tour">Product tour</a>
                  <a href="/integrations/odoo">Odoo integration</a>
                </div>
              </div>
              <div class="s_website_form md-form" data-vcss="001" data-snippet="s_website_form" data-name="Presentation request">
                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/meydara/thank-you">
                  <div class="s_website_form_rows row s_col_no_bgcolor">
                    <div class="s_website_form_field s_website_form_dnone col-12" data-name="Field">
                      <input type="hidden" class="s_website_form_input" name="name" value="Midara presentation request"/>
                    </div>
                    <div class="s_website_form_field col-12 s_website_form_required" data-name="Field" data-type="char">
                      <label class="s_website_form_label" for="contact_contact_name">
                        <span class="s_website_form_label_content">Name</span>
                        <span class="s_website_form_mark"> *</span>
                      </label>
                      <input class="form-control s_website_form_input" id="contact_contact_name" name="contact_name" type="text" data-fill-with="name" required="required"/>
                    </div>
                    <div class="s_website_form_field col-12 " data-name="Field" data-type="char">
                      <label class="s_website_form_label" for="contact_partner_name">
                        <span class="s_website_form_label_content">Company</span>
                      </label>
                      <input class="form-control s_website_form_input" id="contact_partner_name" name="partner_name" type="text" data-fill-with="commercial_company_name"/>
                    </div>
                    <div class="s_website_form_field col-12 s_website_form_required" data-name="Field" data-type="email">
                      <label class="s_website_form_label" for="contact_email_from">
                        <span class="s_website_form_label_content">Work email</span>
                        <span class="s_website_form_mark"> *</span>
                      </label>
                      <input class="form-control s_website_form_input" id="contact_email_from" name="email_from" type="email" data-fill-with="email" required="required"/>
                    </div>
                    <div class="s_website_form_field col-12 " data-name="Field" data-type="tel">
                      <label class="s_website_form_label" for="contact_phone">
                        <span class="s_website_form_label_content">Phone number</span>
                      </label>
                      <input class="form-control s_website_form_input" id="contact_phone" name="phone" type="tel" data-fill-with="phone"/>
                    </div>
                    <div class="s_website_form_field s_website_form_custom col-12" data-name="Field" data-type="selection">
                      <label class="s_website_form_label" for="contact_team">
                        <span class="s_website_form_label_content">Field team size</span>
                      </label>
                      <select class="form-select s_website_form_input" id="contact_team" name="Field team size">
                        <option value="">Select a range</option>
                        <option>1–10</option>
                        <option>11–50</option>
                        <option>51–200</option>
                        <option>200+</option>
                      </select>
                    </div>
                    <div class="s_website_form_field col-12" data-name="Field" data-type="text">
                      <label class="s_website_form_label" for="contact_description">
                        <span class="s_website_form_label_content">What would you like to improve?</span>
                      </label>
                      <textarea class="form-control s_website_form_input" name="description" id="contact_description" rows="4"/>
                    </div>
                    <div class="s_website_form_submit col-12">
                      <a role="button" href="#" class="button button-primary s_website_form_send">Send your request</a>
                      <span id="s_website_form_result"/>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </div>
      </xpath>
    </template>
  </data>
</odoo>
